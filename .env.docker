# ============================================
# Docker Stripe App Environment Variables
# Copy this to .env.docker 同埋填入你嘅值
# ============================================

# Node Environment
NODE_ENV=production

SECRET_KEY=

# Saleor API Configuration
# Replace with your actual Saleor GraphQL API URL
NEXT_PUBLIC_SALEOR_API_URL=

# Stripe Configuration
# Get these from your Stripe Dashboard
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Saleor App Configuration
# Get these when registering the app in Saleor
SALEOR_APP_ID=
SALEOR_APP_TOKEN=

# DynamoDB Configuration (Local)
# Keep these as-is for local DynamoDB
AWS_ENDPOINT_URL_DYNAMODB=http://dynamodb-local:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
DYNAMODB_MAIN_TABLE_NAME=saleor-app-config
APL=dynamodb

# Sentry (Optional - for error tracking)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# OpenTelemetry (Optional - for observability)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

